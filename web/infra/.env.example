# Production stack. Copy to web/infra/.env and fill in.

NFCIT_DOMAIN=nfcintime.example

POSTGRES_DB=nfcit
POSTGRES_USER=nfcit
POSTGRES_PASSWORD=

# Client id from BotFather. Not a secret — the app carries it too — but the
# server needs it to check the audience of an incoming id_token.
NFCIT_TELEGRAM_CLIENT_ID=

# Base64 SHA-256 of the release signing certificate. Empty accepts any signer,
# which defeats the point of attestation — set it before going public.
NFCIT_ATTESTATION_APP_DIGEST=

# The release the app offers to update to: the version code it compares against
# its own, the name it shows, and the APK to fetch. Bumped when a tag is cut;
# a zero code announces nothing and every installation stays as it is.
NFCIT_APP_VERSION_CODE=0
NFCIT_APP_VERSION_NAME=
NFCIT_APP_URL=https://github.com/urionsisdi/nfc-in-time/releases/latest/download/nfc-in-time.apk

# Egress proxy. Needed only where the server cannot reach an upstream directly —
# Telegram's JWKS is blocked by some hosting providers, and sign-in fails with a
# timeout on `fetch jwks` when it is. Leave both empty to connect directly.
# NFCIT_NO_PROXY lists what to keep off the proxy: Google's revocation list is
# usually reachable, and attestation should not depend on a third party.
NFCIT_HTTPS_PROXY=
NFCIT_NO_PROXY=android.googleapis.com

# Backups: a dump every 12 hours, the last 14 kept. NFCIT_BACKUP_DIR is a host
# path, so the dumps survive `docker compose down -v`.
NFCIT_BACKUP_DIR=./backups
NFCIT_BACKUP_INTERVAL_SECONDS=43200
NFCIT_BACKUP_KEEP=14
