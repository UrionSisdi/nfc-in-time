<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 draws the launch screen itself, from the launcher icon. Only
         the field behind it has to be named, or it comes up in the system accent. -->
    <style name="Theme.NfcInTime" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
